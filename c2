--  AIM ENGINE (with Hold/Toggle)
-- ════════════════════════════════════════════════════════════
local aimActive = false
local lastToggle = 0
local fovCircle, softFovCircle

local function getAimKey()
    return Enum.KeyCode[cfg.aimKey] or Enum.KeyCode.LeftShift
end
local function getSmoothSpeed(s)
    return 1 / (1 + s * 4.8)
end
local function getClosestEnemy(fov, wallCheck)
    local closest, closestDist = nil, fov
    local char = player.Character
    if not char then return nil end
    local mousePos = uis:GetMouseLocation()
    for _, enemy in pairs(Players:GetPlayers()) do
        if enemy == player then continue end
        local eChar = enemy.Character
        if not eChar then continue end
        local eHum = eChar:FindFirstChild("Humanoid")
        if not eHum or eHum.Health <= 0 then continue end
        local eHead = eChar:FindFirstChild("Head")
        local eRoot = eChar:FindFirstChild("HumanoidRootPart")
        if not eHead or not eRoot then continue end
        if wallCheck then
            local origin = Camera.CFrame.Position
            local dir = (eHead.Position - origin).Unit
            local ray = Ray.new(origin, dir * 1000)
            local hit = workspace:FindPartOnRay(ray, char)
            if hit and not hit:IsDescendantOf(eChar) then continue end
        end
        local hp, on = Camera:WorldToViewportPoint(eHead.Position)
        if not on then continue end
        local dist = (Vector2.new(hp.X, hp.Y) - mousePos).Magnitude
        if dist < closestDist then
            if cfg.teamCheck then
                local mt, et = player.Team, enemy.Team
                if (mt and et and mt ~= et) or (not mt and not et) then
                    closestDist = dist; closest = enemy
                end
            else
                closestDist = dist; closest = enemy
            end
        end
    end
    return closest
end
local function getAimPosition(target, mode)
    if not target or not target.Character then return nil end
    local tc = target.Character
    local head = tc:FindFirstChild("Head")
    local root = tc:FindFirstChild("HumanoidRootPart")
    if not head then return nil end
    if mode == "Soft" and cfg.softRandomTarget then
        return (math.random(1,2) == 1) and head.Position or (root and (head.Position + root.Position)/2 or head.Position)
    end
    local offset = cfg.aimOffset
    if root then
        return head.Position:Lerp(root.Position, offset * 1.2)
    else
        return head.Position - Vector3.new(0, offset * 3, 0)
    end
end

uis.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode == getAimKey()
        and cfg.aimToggleMode
        and not waitingForKey then
        if tick() - lastToggle > 0.2 then aimActive = not aimActive; lastToggle = tick() end
    end
end)

RunService.RenderStepped:Connect(function()
    local shouldAim = cfg.aimToggleMode and aimActive or uis:IsKeyDown(getAimKey())
    if shouldAim then
        if cfg.aimbotEnabled then
            pcall(function()
                local t = getClosestEnemy(cfg.aimbotFOV, cfg.aimbotWallCheck)
                if t then
                    local pos = getAimPosition(t, "Aim")
                    if pos then Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), 0.3) end
                end
            end)
        elseif cfg.softEnabled then
            pcall(function()
                local t = getClosestEnemy(cfg.softFOV, cfg.softWallCheck)
                if t then
                    local pos = getAimPosition(t, "Soft")
                    if pos then Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), getSmoothSpeed(cfg.softSmoothness)) end
                end
            end)
        end
    end

    if cfg.aimbotVisualizeFOV and cfg.aimbotEnabled then
        if not fovCircle then fovCircle = Drawing.new("Circle"); fovCircle.Thickness = 2; fovCircle.NumSides = 64; fovCircle.Filled = false; fovCircle.Transparency = 0.5 end
        fovCircle.Visible = true
        fovCircle.Radius = cfg.aimbotFOV
        fovCircle.Color = Color3.fromRGB(cfg.aimbotFOVColor[1], cfg.aimbotFOVColor[2], cfg.aimbotFOVColor[3])
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    elseif fovCircle then fovCircle.Visible = false end

    if cfg.softVisualizeFOV and cfg.softEnabled then
        if not softFovCircle then softFovCircle = Drawing.new("Circle"); softFovCircle.Thickness = 2; softFovCircle.NumSides = 64; softFovCircle.Filled = false; softFovCircle.Transparency = 0.5 end
        softFovCircle.Visible = true
        softFovCircle.Radius = cfg.softFOV
        softFovCircle.Color = Color3.fromRGB(cfg.softFOVColor[1], cfg.softFOVColor[2], cfg.softFOVColor[3])
        softFovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    elseif softFovCircle then softFovCircle.Visible = false end
end)

