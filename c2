-- ─── helpers ─────────────────────────────────────────────────
local function corner(px, parent)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, px)
    c.Parent = parent
    return c
end
local function padding(t, l, r, b, parent)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, t or 0)
    p.PaddingLeft   = UDim.new(0, l or 0)
    p.PaddingRight  = UDim.new(0, r or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = parent
    return p
end

-- ─── renameMelee (with automatic slot fallback) ────────────
local currentMelee = "Dagger"

local function renameMelee(newName)
    -- First try to rename the current slot
    local success, err = pcall(function()
        local slot = player.PlayerGui.Favourites.Melees[currentMelee]
        if slot then
            slot.Name = newName
            currentMelee = newName
            return true
        end
        return false
    end)
    if success then
        return true
    end
    -- If that fails, try the "Dagger" slot as fallback
    local ok, err2 = pcall(function()
        local daggerSlot = player.PlayerGui.Favourites.Melees["Dagger"]
        if daggerSlot then
            daggerSlot.Name = newName
            currentMelee = newName
            return true
        end
        return false
    end)
    if not ok then
        warn("Failed to rename melee: " .. tostring(err2))
        return false
    end
    return true
end

-- ─── Restore saved melee on load ──────────────────────────
if cfg.selectedMelee ~= "Dagger" then
    task.defer(function()
        local elapsed = 0
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            elapsed += dt
            local ok = pcall(function()
                local slot = player.PlayerGui.Favourites.Melees["Dagger"]
                if slot then
                    slot.Name = cfg.selectedMelee
                    currentMelee = cfg.selectedMelee
                    return true
                end
                return false
            end)
            if ok then
                conn:Disconnect()
            elseif elapsed > 10 then
                warn("C2Hub: Could not restore saved melee slot within 10s")
                conn:Disconnect()
            end
        end)
    end)
else
    currentMelee = "Dagger"
end

