local function aimSlider(label, configKey, min, max, step, yPos, fmt)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 52)
    row.Position = UDim2.new(0, 0, 0, yPos)
    row.BackgroundColor3 = C.bg0
