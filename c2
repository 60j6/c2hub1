local espBoxCache  = {}
local espTextCache = {}

local espTeamColors = {
    ["Red"]    = Color3.fromRGB(255,  50,  50),
    ["Blue"]   = Color3.fromRGB( 50, 150, 255),
    ["Green"]  = Color3.fromRGB( 50, 255,  50),
    ["Yellow"] = Color3.fromRGB(255, 255,  50),
    ["Purple"] = Color3.fromRGB(200,  50, 255),
    ["Orange"] = Color3.fromRGB(255, 150,  50),
    ["Neon"]   = Color3.fromRGB(  0, 255, 200),
    ["Pink"]   = Color3.fromRGB(255, 100, 200),
}

local function espGetTeamColor(plr)
    if not plr.Team then return Color3.fromRGB(200, 200, 200) end
    local c = espTeamColors[plr.Team.Name]
    if c then return c end
    local tc = plr.Team.TeamColor
    return tc and tc.Color or Color3.fromRGB(200, 200, 200)
end

local function espHide(name)
    if espBoxCache[name]  then espBoxCache[name].Visible  = false end
    if espTextCache[name] then espTextCache[name].Visible = false end
end

Players.PlayerRemoving:Connect(function(plr)
    local n = plr.Name
    if espBoxCache[n]  then espBoxCache[n]:Remove();  espBoxCache[n]  = nil end
    if espTextCache[n] then espTextCache[n]:Remove(); espTextCache[n] = nil end
end)

RunService.RenderStepped:Connect(function()
    if not espSettings.Enabled then
        for n in pairs(espBoxCache) do espHide(n) end
        return
    end
    for _, plr in pairs(Players:GetPlayers()) do
        local char = plr.Character
        local n    = plr.Name
        if plr == player then espHide(n); continue end
        if espSettings.TeamCheck and plr.Team and player.Team and plr.Team == player.Team then
            espHide(n); continue
        end
        if not char then espHide(n); continue end
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hrp or not head then espHide(n); continue end
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then espHide(n); continue end

        local col = espGetTeamColor(plr)

        if not espBoxCache[n] then
            local b = Drawing.new("Square")
            b.Thickness = 2
            b.Filled = false
            b.Transparency = 1
            espBoxCache[n] = b
        end
        local box = espBoxCache[n]
        local topPt = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2.5, 0))
        local botPt = Camera:WorldToViewportPoint(hrp.Position  - Vector3.new(0, 2.5, 0))
        local h = math.max(math.abs(topPt.Y - botPt.Y), 40)
        local w = math.max(h * 0.7, 28)
        box.Size     = Vector2.new(w, h)
        box.Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
        box.Color    = col
        box.Visible  = true

        if not espTextCache[n] then
            local t = Drawing.new("Text")
            t.Size = 18; t.Center = true; t.Outline = true
            t.OutlineColor = Color3.fromRGB(0, 0, 0)
            t.Transparency = 1
            t.Font = Drawing.Fonts.Plex
            espTextCache[n] = t
        end
        local txt = espTextCache[n]
        local label = plr.DisplayName or plr.Name
        if espSettings.ShowDistance then
            local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
            label = label .. "  [" .. dist .. "m]"
        end
        txt.Text     = label
        txt.Color    = col
        txt.Position = Vector2.new(pos.X, pos.Y - h/2 - 25)
        txt.Visible  = true
    end
end)

