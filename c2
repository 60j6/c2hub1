-- Motion Blur
local motionBlurEnabled = cfg.motionBlur
local motionBlurConn = nil
local motionBlurEffect = nil

local function enableMotionBlur()
    if motionBlurEnabled then return end
    motionBlurEnabled = true
    local cam = workspace.CurrentCamera
    if not cam then return end
    motionBlurEffect = Instance.new("BlurEffect")
    motionBlurEffect.Name = "C2MotionBlur"
    motionBlurEffect.Size = 0
    motionBlurEffect.Parent = cam
    local lastVec = cam.CFrame.LookVector
    local currentSize = 0
    motionBlurConn = RunService.Heartbeat:Connect(function(dt)
        if not motionBlurEnabled then return end
        local c = workspace.CurrentCamera
        if not c or not motionBlurEffect then return end
        local newVec = c.CFrame.LookVector
        local mag = (newVec - lastVec).Magnitude
        if mag > 0.005 then
            currentSize = currentSize + (math.min(mag / dt * 0.8, 22) - currentSize) * 0.15
        else
            currentSize = currentSize * 0.95
        end
        motionBlurEffect.Size = currentSize
        lastVec = newVec
    end)
end

local function disableMotionBlur()
    if not motionBlurEnabled then return end
    motionBlurEnabled = false
    if motionBlurConn then motionBlurConn:Disconnect(); motionBlurConn = nil end
    if motionBlurEffect then motionBlurEffect:Destroy(); motionBlurEffect = nil end
end

