local function isfileAvailable()  return type(isfile)  == "function" end
local function readfileAvailable() return type(readfile) == "function" end
local function writefileAvailable() return type(writefile) == "function" end
local function mkdirAvailable()  return type(makefolder) == "function" end

local function jsonEncode(t)
    local parts = {}
    for k, v in pairs(t) do
        local vStr
        if type(v) == "boolean" or type(v) == "number" then
            vStr = tostring(v)
        else
            vStr = '"' .. tostring(v):gsub('"', '\\"') .. '"'
        end
        table.insert(parts, '"' .. k .. '": ' .. vStr)
    end
    return "{\n  " .. table.concat(parts, ",\n  ") .. "\n}"
end

local function jsonDecode(s)
    local result = {}
    for k, v in s:gmatch('"([^"]+)"%s*:%s*([^,}\n]+)') do
        v = v:match("^%s*(.-)%s*$")
        if v == "true" then result[k] = true
        elseif v == "false" then result[k] = false
        elseif tonumber(v) then result[k] = tonumber(v)
        else result[k] = v:match('^"(.*)"$') or v
        end
    end
    return result
end

local function loadSettings()
    for k, v in pairs(defaultSettings) do cfg[k] = v end
    if not (isfileAvailable() and readfileAvailable()) then return end
    local ok, data = pcall(function()
        if isfile(SAVE_FILE) then return readfile(SAVE_FILE) end
    end)
    if ok and data and data ~= "" then
        local success, decoded = pcall(jsonDecode, data)
        if success and decoded then
            for k in pairs(defaultSettings) do
                if decoded[k] ~= nil then cfg[k] = decoded[k] end
            end
        end
    end
end

local function saveSettings()
    if not writefileAvailable() then return end
    if mkdirAvailable() then pcall(makefolder, "C2Hub") end
    pcall(writefile, SAVE_FILE, jsonEncode(cfg))
end

loadSettings()

