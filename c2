-- Skin changer logic (unchanged)
local ArmsFolder = ReplicatedStorage:FindFirstChild("Viewmodels") and ReplicatedStorage.Viewmodels:FindFirstChild("Arms")
local armsCache = {}
local function getArmParts(folder)
    local parts = {}
    for _, c in ipairs(folder:GetChildren()) do
        if c:IsA("BasePart") or c:IsA("Model") then table.insert(parts, c) end
    end
    return parts
end
local function cacheArms(n)
    if armsCache[n] or not ArmsFolder then return end
    local f = ArmsFolder:FindFirstChild(n)
    if not f then return end
    armsCache[n] = {}
    for _, arm in ipairs(getArmParts(f)) do table.insert(armsCache[n], arm:Clone()) end
end
local function equipArms(ownedName, targetName)
    if not ArmsFolder then return end
    local of = ArmsFolder:FindFirstChild(ownedName)
    local tf = ArmsFolder:FindFirstChild(targetName)
    if not of or not tf then return end
    cacheArms(ownedName); cacheArms(targetName)
    for _, arm in ipairs(getArmParts(of)) do arm:Destroy() end
    if armsCache[targetName] then
        for _, arm in ipairs(armsCache[targetName]) do arm:Clone().Parent = of end
    end
end

local function applySkin()
    local character = player.Character or player.CharacterAdded:Wait()
    local ownedName  = ownedSkinInput.Text
    local targetName = targetSkinInput.Text
    if ownedName == "" or targetName == "" then setSkinStatus("Fill in both fields!", C.err); return end

    local scrollingFrame = player.PlayerGui:WaitForChild("Menew"):WaitForChild("Locker")
        :WaitForChild("Equipping"):WaitForChild("ScrollingFrame")
    local ownedFrame = scrollingFrame:FindFirstChild(ownedName)
    if not ownedFrame then setSkinStatus("'" .. ownedName .. "' not found! Locker open?", C.err); return end

    ownedFrame.Name = targetName
    setSkinStatus("Renamed! Click it in the locker...", C.warn)

    local worldModel = player.PlayerGui:WaitForChild("Menew"):WaitForChild("Locker")
        :WaitForChild("Equipping"):WaitForChild("LockerMain"):WaitForChild("Item")
        :WaitForChild("ViewportFrame"):WaitForChild("WorldModel")
    local skinModel = worldModel:WaitForChild(targetName, 15)
    if not skinModel then setSkinStatus("Model didn't load! Did you click it?", C.err); ownedFrame.Name = ownedName; return end

    setSkinStatus("Model loaded! Applying...", C.ok)
    local characterHead = character:FindFirstChild("Head")

    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("BodyColors")
            or obj:IsA("Accessory") or obj:IsA("Hat") or obj:IsA("ShirtGraphic") then obj:Destroy() end
    end
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("BasePart") and obj.Name == "Handle" then obj:Destroy() end
    end
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Weld") and obj.Name == "AccessoryWeld" then obj:Destroy() end
    end
    for _, obj in ipairs(skinModel:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("BodyColors") or obj:IsA("ShirtGraphic") then
            obj:Clone().Parent = character end
    end
    for _, obj in ipairs(skinModel:GetChildren()) do
        if obj:IsA("BasePart") and obj.Name == "Handle" then
            local clone = obj:Clone()
            clone.Massless = true; clone.CanCollide = false; clone.Anchored = false; clone.Parent = character
            local accAtt = clone:FindFirstChildOfClass("Attachment")
            if accAtt then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("Attachment") and part.Name == accAtt.Name and part.Parent ~= clone then
                        local w = Instance.new("Weld"); w.Name = "AccessoryWeld"
                        w.Part0 = clone; w.Part1 = part.Parent
                        w.C0 = clone.CFrame:ToObjectSpace(accAtt.WorldCFrame)
                        w.C1 = part.Parent.CFrame:ToObjectSpace(part.WorldCFrame)
                        w.Parent = clone; break
                    end
                end
            end
        end
    end

    local skinHead       = skinModel:FindFirstChild("Head")
    local skinBodyColors = skinModel:FindFirstChildOfClass("BodyColors")
    if skinHead and characterHead then
        local headColor = skinHead.Color
        if skinBodyColors then headColor = skinBodyColors.HeadColor3 end
        characterHead.Color = headColor
        for _, obj in ipairs(characterHead:GetChildren()) do
            if obj:IsA("SurfaceAppearance") or obj:IsA("Decal") then obj:Destroy() end
        end
        for _, obj in ipairs(skinHead:GetChildren()) do
            if obj:IsA("SurfaceAppearance") or obj:IsA("Decal") then obj:Clone().Parent = characterHead end
        end
        task.spawn(function()
            while character and character.Parent do
                if characterHead.Color ~= headColor then characterHead.Color = headColor end
                task.wait(0.1)
            end
        end)
    end

    setSkinStatus("Skin applied!", C.ok)
    task.spawn(function() equipArms(ownedName, targetName) end)
    ownedFrame.Name = ownedName
end

