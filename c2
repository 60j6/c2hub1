    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.65, 0, 0, 20)
    lbl.Position = UDim2.new(0, 0, 0, 8)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.t2
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0.35, 0, 0, 20)
    valLbl.Position = UDim2.new(0.65, 0, 0, 8)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = fmt and fmt(cfg[configKey]) or tostring(cfg[configKey])
    valLbl.TextColor3 = C.accentL
    valLbl.Font = Enum.Font.Code
    valLbl.TextSize = 12
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 4)
    track.Position = UDim2.new(0, 0, 0, 36)
    track.BackgroundColor3 = C.bg4
    track.BorderSizePixel = 0
    track.Parent = row
    corner(2, track)

    local fill = Instance.new("Frame")
    local pct = (cfg[configKey] - min) / (max - min)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = C.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(2, fill)

    local thumb = Instance.new("TextButton")
    thumb.Size = UDim2.new(0, 14, 0, 14)
    thumb.Position = UDim2.new(pct, -7, 0.5, -7)
    thumb.BackgroundColor3 = C.accentH
    thumb.BorderSizePixel = 0
    thumb.Text = ""
    thumb.Parent = row
    corner(7, thumb)

    local dragging = false
    thumb.MouseButton1Down:Connect(function() dragging = true end)
    uis.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    uis.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local tp = track.AbsolutePosition.X
            local ts = track.AbsoluteSize.X
            local p = math.clamp((uis:GetMouseLocation().X - tp) / ts, 0, 1)
            local v = min + p * (max - min)
            if step then v = math.round(v / step) * step end
            v = math.clamp(v, min, max)
            cfg[configKey] = v
            fill.Size = UDim2.new(p, 0, 1, 0)
            thumb.Position = UDim2.new(p, -7, 0.5, -7)
            valLbl.Text = fmt and fmt(v) or tostring(v)
            saveSettings()
        end
    end)
    return row
end

